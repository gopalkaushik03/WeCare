# backend/.env.example
# Copy this file to backend/.env and fill in real credentials.
# NEVER commit backend/.env to version control.

# -------------------------------------------------------------------
# Required — Gemini AI (Google AI Studio)
# Get yours at: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------------
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# -------------------------------------------------------------------
# Required — MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# -------------------------------------------------------------------
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING
MONGO_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING

# -------------------------------------------------------------------
# Optional — database name (defaults to "wecare")
# -------------------------------------------------------------------
MONGODB_DB=wecare

# -------------------------------------------------------------------
# Optional — comma-separated extra CORS origins for preview deploys
# Example: https://my-preview.vercel.app,https://staging.example.com
# -------------------------------------------------------------------
ALLOWED_ORIGINS=
