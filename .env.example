# ===========================
# WeCare Environment Configuration
# ===========================
# For Next.js  → copy to .env.local  (project root)
# For FastAPI  → copy to backend/.env
# ⚠️  NEVER commit the real files – they are in .gitignore

# -------------------------------------------------------
# MongoDB Atlas
# -------------------------------------------------------
# URI-encode special chars in the password (@ → %40, etc.)
MONGODB_URI=mongodb+srv://<db_user>:<uri_encoded_password>@<cluster>.mongodb.net/?appName=WeCare
MONGODB_DB=wecare

# -------------------------------------------------------
# Google Gemini API
# -------------------------------------------------------
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# App URL (Next.js)
# -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
